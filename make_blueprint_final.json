{
    "name": "Funnel email y captura - FINAL",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": 3841712,
                "maxResults": 1
            },
            "mapper": {}
        },
        {
            "id": 2,
            "module": "google-sheets:addRow",
            "version": 2,
            "parameters": { "__IMTCONN__": 13840688 },
            "mapper": {
                "from": "drive",
                "mode": "select",
                "values": {
                    "0": "{{1.contact.name}}",
                    "1": "{{1.contact.lastname}}",
                    "2": "{{1.contact.company}}",
                    "3": "{{1.contact.email}}",
                    "4": "{{1.meta.meetingOptIn}}",
                    "5": "{{1.contact.pain_point_1}}",
                    "6": "{{1.contact.pain_point_2}}",
                    "7": "{{1.contact.pain_point_3}}",
                    "8": "{{1.survey.answers.q1}}",
                    "9": "{{1.survey.answers.q2}}",
                    "10": "{{1.survey.answers.q3}}",
                    "11": "{{1.survey.answers.q4}}",
                    "12": "{{1.survey.answers.q5}}",
                    "13": "{{1.survey.answers.q6}}",
                    "14": "{{1.survey.answers.q7}}",
                    "15": "{{1.survey.answers.q8}}"
                },
                "sheetId": "Hoja 2",
                "spreadsheetId": "/1i8bBg7BtUvJhNnoZF39yfdgPIWPmSJ2potzI-SgTd9U",
                "includesHeaders": true,
                "insertDataOption": "INSERT_ROWS",
                "useColumnHeaders": false,
                "valueInputOption": "USER_ENTERED"
            }
        },
        {
            "id": 12,
            "module": "openai-gpt-3:CreateCompletion",
            "version": 1,
            "parameters": { "__IMTCONN__": 13840674 },
            "mapper": {
                "model": "o4-mini",
                "select": "chat",
                "messages": [
                    {
                        "role": "system",
                        "content": "Eres un consultor senior de Recursos Humanos. Genera un análisis ejecutivo breve (máx 300 palabras) en español."
                    },
                    {
                        "role": "user",
                        "content": "Empresa: {{1.contact.company}}, Contacto: {{1.contact.name}} {{1.contact.lastname}}, Pain Points: {{1.contact.pain_point}}, Score: {{1.survey.globalScore}}/100, D1:{{1.survey.scores.D1}}, D2:{{1.survey.scores.D2}}, D3:{{1.survey.scores.D3}}, D4:{{1.survey.scores.D4}}, T:{{1.survey.scores.T}}"
                    }
                ],
                "max_tokens": 1500,
                "temperature": 0.3
            }
        },
        {
            "id": 8,
            "module": "microsoft-email:createAndSendAMessage",
            "version": 2,
            "parameters": { "__IMTCONN__": 7366787 },
            "mapper": {
                "content": "<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;\">\n<h2>Nuevo Lead</h2>\n<p><strong>Empresa:</strong> {{1.contact.company}}</p>\n<p><strong>Contacto:</strong> {{1.contact.name}} {{1.contact.lastname}}</p>\n<p><strong>Email:</strong> {{1.contact.email}}</p>\n<p><strong>Puntuación:</strong> {{1.survey.globalScore}}/100</p>\n<p><strong>Estado:</strong> {{1.meta.meetingOptIn}}</p>\n<hr>\n<h3>Análisis IA:</h3>\n<div style=\"background:#f5f5f5;padding:15px;\">{{12.choices[].message.content}}</div>\n</div>",
                "subject": "Nuevo Lead: {{1.contact.company}} ({{1.survey.globalScore}}/100)",
                "contentType": "html",
                "toRecipients": [
                    { "address": "jgpino@gfs.es", "name": "Joaquín" },
                    { "address": "tromanp@gfs.es", "name": "Tomás" }
                ]
            }
        },
        {
            "id": 3,
            "module": "builtin:BasicRouter",
            "version": 1,
            "routes": [
                {
                    "flow": [
                        {
                            "id": 4,
                            "module": "microsoft-email:createAndSendAMessage",
                            "version": 2,
                            "parameters": { "__IMTCONN__": 8240324 },
                            "filter": {
                                "name": "Si agendó",
                                "conditions": [[{ "a": "{{1.meta.meetingOptIn}}", "o": "text:contain", "b": "Confirmed" }]]
                            },
                            "mapper": {
                                "toRecipients": [{ "address": "{{1.contact.email}}", "name": "{{1.contact.name}}" }],
                                "subject": "{{1.contact.name}}, tu diagnóstico está listo",
                                "content": "<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;\">\n<h2>Gracias por agendar</h2>\n<p>Hola <strong>{{1.contact.name}}</strong>,</p>\n<p>Tu puntuación global: <strong>{{1.survey.globalScore}}</strong>/100</p>\n<p>Tu sesión está confirmada. Te esperan en el calendario.</p>\n<hr>\n<p><strong>Ver tus resultados:</strong></p>\n<p><a href=\"https://diagnostico-rrhh-2026.vercel.app/#/mis-resultados?score={{1.survey.globalScore}}&d1={{1.survey.scores.D1}}&d2={{1.survey.scores.D2}}&d3={{1.survey.scores.D3}}&d4={{1.survey.scores.D4}}&t={{1.survey.scores.T}}\" style=\"background:#0ea5e9;color:#fff;padding:12px 24px;text-decoration:none;border-radius:6px;display:inline-block;\">Ver Dashboard Online</a></p>\n<p><a href=\"https://diagnostico-rrhh-2026.vercel.app/#/resultado?score={{1.survey.globalScore}}&d1={{1.survey.scores.D1}}&d2={{1.survey.scores.D2}}&d3={{1.survey.scores.D3}}&d4={{1.survey.scores.D4}}&t={{1.survey.scores.T}}\" style=\"color:#0ea5e9;\">Descargar Informe PDF</a></p>\n<hr>\n<p>Nos vemos pronto.</p>\n<p><strong>Joaquín González del Pino</strong><br>GFS Consulting</p>\n</div>",
                                "contentType": "html",
                                "from": [{ "address": "jgpino@gfs.es", "name": "Joaquín González" }],
                                "bccRecipients": [
                                    { "address": "jgpino@gfs.es", "name": "Joaquín" },
                                    { "address": "tromanp@gfs.es", "name": "Tomás" }
                                ]
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 7,
                            "module": "util:FunctionSleep",
                            "version": 1,
                            "mapper": { "duration": "300" }
                        },
                        {
                            "id": 6,
                            "module": "microsoft-email:createAndSendAMessage",
                            "version": 2,
                            "parameters": { "__IMTCONN__": 8240324 },
                            "filter": {
                                "name": "Si no agendó",
                                "conditions": [[{ "a": "{{1.meta.meetingOptIn}}", "o": "text:equal", "b": "Skipped" }]]
                            },
                            "mapper": {
                                "toRecipients": [{ "address": "{{1.contact.email}}", "name": "{{1.contact.name}}" }],
                                "subject": "Tu diagnóstico organizacional - Resultados",
                                "content": "<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;\">\n<p>Hola <strong>{{1.contact.name}}</strong>,</p>\n<p>Tu puntuación global: <strong>{{1.survey.globalScore}}</strong>/100</p>\n<hr>\n<p><strong>Descargar tu informe:</strong></p>\n<p><a href=\"https://diagnostico-rrhh-2026.vercel.app/#/resultado?score={{1.survey.globalScore}}&d1={{1.survey.scores.D1}}&d2={{1.survey.scores.D2}}&d3={{1.survey.scores.D3}}&d4={{1.survey.scores.D4}}&t={{1.survey.scores.T}}\" style=\"background:#0ea5e9;color:#fff;padding:12px 24px;text-decoration:none;border-radius:6px;display:inline-block;\">Descargar Informe PDF</a></p>\n<hr>\n<p>Si quieres que te explique tus resultados, agenda una llamada.</p>\n<p><a href=\"https://calendly.com/joaquingfs/diagnostico-ejecutivo-y-hoja-de-ruta\">Agenda aquí</a></p>\n<p>Joaquín González del Pino<br>GFS Consulting</p>\n</div>",
                                "contentType": "html",
                                "from": [{ "address": "jgpino@gfs.es", "name": "Joaquín González" }],
                                "bccRecipients": [
                                    { "address": "jgpino@gfs.es", "name": "Joaquín" },
                                    { "address": "tromanp@gfs.es", "name": "Tomás" }
                                ]
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 9,
                            "module": "microsoft-email:createAndSendAMessage",
                            "version": 2,
                            "parameters": { "__IMTCONN__": 8240324 },
                            "filter": {
                                "name": "Si solo completó",
                                "conditions": [[{ "a": "{{1.meta.meetingOptIn}}", "o": "text:contain", "b": "Pending" }]]
                            },
                            "mapper": {
                                "toRecipients": [{ "address": "{{1.contact.email}}", "name": "{{1.contact.name}}" }],
                                "subject": "Tu diagnóstico organizacional - Resultados",
                                "content": "<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;\">\n<p>Hola <strong>{{1.contact.name}}</strong>,</p>\n<p>Gracias por completar el diagnóstico.</p>\n<p>Tu puntuación global: <strong>{{1.survey.globalScore}}</strong>/100</p>\n<hr>\n<p><strong>Descargar tu informe:</strong></p>\n<p><a href=\"https://diagnostico-rrhh-2026.vercel.app/#/resultado?score={{1.survey.globalScore}}&d1={{1.survey.scores.D1}}&d2={{1.survey.scores.D2}}&d3={{1.survey.scores.D3}}&d4={{1.survey.scores.D4}}&t={{1.survey.scores.T}}\" style=\"background:#0ea5e9;color:#fff;padding:12px 24px;text-decoration:none;border-radius:6px;display:inline-block;\">Descargar Informe PDF</a></p>\n<hr>\n<p>¿Quieres que te explique tus resultados?</p>\n<p><a href=\"https://calendly.com/joaquingfs/diagnostico-ejecutivo-y-hoja-de-ruta\">Agenda una llamada de 15 min</a></p>\n<p>Joaquín González del Pino<br>GFS Consulting</p>\n</div>",
                                "contentType": "html",
                                "from": [{ "address": "jgpino@gfs.es", "name": "Joaquín González" }],
                                "bccRecipients": [
                                    { "address": "jgpino@gfs.es", "name": "Joaquín" },
                                    { "address": "tromanp@gfs.es", "name": "Tomás" }
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true
        },
        "zone": "eu2.make.com"
    }
}
